# AI-Lab-Commander 环境变量配置模板
# 复制此文件为 .env 并填入你的 API 密钥
# 注意：并非所有密钥都是必需的，但配置越多功能越完整

# Gemini API (谷歌)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# xAI API (Grok)
XAI_API_KEY=your_xai_api_key_here

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_TESTER_API_KEY=your_deepseek_tester_api_key_here

# 智谱AI (GLM)
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# 通义千问 (Qwen)
QWEN_API_KEY=your_qwen_api_key_here

# 火山引擎 (VolcEngine/Ark)
VOLCENGINE_API_KEY=your_volcengine_api_key_here

# NovAI (Gemini代理)
NOVAI_API_KEY=your_novai_api_key_here

# Claude Custom (自定义Claude端点)
CLAUDE_CUSTOM_API_KEY=your_claude_custom_api_key_here

# HIAPI (未知服务)
HIAPI_API_KEY=your_hiapi_api_key_here
